###
### FUNCTIONS
###

# Open files/URLs in the background, detached from the shell
open() {
	xdg-open "$@" &>/dev/null &!
}

# Use trizen (AUR) for normal users, plain pacman for root
pacman() {
	if (( EUID == 0 )) || ! (( $+commands[trizen] )); then
		command pacman "$@"
	else
		trizen "$@"
	fi
}

# Search repos and AUR
pacs() {
	trizen -Ssa --color=always "$1"
	trizen -Ssr --color=always "$1"
}

# extract archive... [destdir]
extract() {
	local dir=. archive
	if (( $# > 1 )) && [[ -d ${@[-1]} || ! -f ${@[-1]} ]]; then
		dir=${@[-1]}
		mkdir -p -- "$dir"
	fi
	for archive in "$@"; do
		[[ $archive == "$dir" ]] && continue
		if [[ ! -f $archive ]]; then
			echo "'$archive' is not a valid archive file!"
			continue
		fi
		case $archive in
			*.tar.bz2|*.tbz2) tar -C "$dir" -xvjf "$archive" ;;
			*.tar.gz|*.tgz)   tar -C "$dir" -xvzf "$archive" ;;
			*.tar.xz|*.txz)   tar -C "$dir" -xvJf "$archive" ;;
			*.bz2)            bunzip2 -c "$archive" > "$dir/${archive:t:r}" ;;
			*.gz)             gunzip -c "$archive" > "$dir/${archive:t:r}" ;;
			*.tar)            tar -C "$dir" -xvf "$archive" ;;
			*.zip|*.jar)      unzip -d "$dir" "$archive" ;;
			*.rar)            unrar x "$archive" "$dir" ;;
			*.Z)              uncompress -c "$archive" > "$dir/${archive:t:r}" ;;
			*.7z)             7z x -o"$dir" "$archive" ;;
			*)
				echo "Unknown file extension, detecting mime type..."
				case $(file -b --mime-type "$archive") in
					application/x-bzip2)         tar -C "$dir" -xvjf "$archive" ;;
					application/x-gzip|application/gzip) tar -C "$dir" -xvzf "$archive" ;;
					application/x-xz)            tar -C "$dir" -xvJf "$archive" ;;
					application/zip|application/java-archive) unzip -d "$dir" "$archive" ;;
					application/x-rar)           unrar x "$archive" "$dir" ;;
					application/x-7z-compressed) 7z x -o"$dir" "$archive" ;;
					*) echo "don't know how to extract '$archive'" ;;
				esac
				;;
		esac
	done
}

# pack archive_file file [dir|file]...
pack() {
	if (( $# < 2 )); then
		echo "Usage: pack archive_file file [dir|file]..."
		return 1
	fi
	[[ -e $1 ]] && { echo "error: destination $1 exists"; return 1 }

	case ${(L)1} in
		*.tar.bz2|*.tbz2) tar --dereference -cvjf "$@" ;;
		*.tar.gz|*.tgz)   tar --dereference -cvzf "$@" ;;
		*.tar.xz)         tar --dereference -cvJf "$@" ;;
		*.tar.lzma)       tar --dereference --lzma -cvf "$@" ;;
		*.tar)            tar --dereference -cvf "$@" ;;
		*.bz2)            7za a -tbzip2 "$@" ;;
		*.gz)             7za a -tgzip "$@" ;;
		*.rar)            rar a -r "$@" ;;
		*.zip)            zip -r "$@" ;;
		*.7z)             7za a -t7z -mmt "$@" ;;
		*) echo "I don't know what to do with '$1'" ;;
	esac
}

# Reload zsh config
reload() {
	exec zsh
}

# Pull dotfiles, reinstall the shared config and reload
update_conf() {
	local repo=${DOTFILES:-$HOME/dotfiles}
	git -C "$repo" pull && sudo "$repo/zsh/install.sh" && exec zsh
}

whois() {
	command whois -H "$@" | iconv -f iso-8859-1 -t utf-8
}

# Show .nfo files with their original cp437 charset
less() {
	case $1 in
		*.nfo|*.NFO)
			local f
			for f in "$@"; do
				iconv -f cp437 -t utf-8 < "$f" | command less
			done
			;;
		*)
			command less "$@"
			;;
	esac
}

diff() {
	if (( $+commands[colordiff] )); then
		colordiff "$@"
	else
		command diff "$@"
	fi
}

prettify-json() {
	local tmp
	tmp=$(mktemp) && jq . < "$1" > "$tmp" && mv -- "$tmp" "$1"
}

minify-json() {
	local tmp
	tmp=$(mktemp) && jq -c . < "$1" > "$tmp" && mv -- "$tmp" "$1"
}

# mssh host1 host2 ...: one tiled tmux window with an ssh pane per host
mssh() {
	if [[ -z $1 ]]; then
		echo "Usage: mssh host1 host2 host{01..03}.example.com"
		return 1
	fi
	local host first=$1
	shift
	tmux new-window -n "mssh: ${first%%.*}" "ssh $first"
	for host in "$@"; do
		tmux split-window -h "ssh $host"
		tmux select-layout tiled
	done
	# tmux set-window-option synchronize-panes on
	tmux select-pane -t 0
}

# yazi; cd to its last directory on exit
y() {
	local tmp cwd
	tmp=$(mktemp -t yazi-cwd.XXXXXX)
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[[ -n $cwd && $cwd != "$PWD" && -d $cwd ]] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

