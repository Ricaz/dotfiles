# Terminal title (and tmux window name): current dir [user@host]
autoload -Uz add-zsh-hook
_set_title() {
	local dir=${(%):-%~}
	(( ${#dir} > 18 )) && dir=..${dir[-15,-1]}
	printf '\e]0;%s [%s@%s]\a' "$dir" "${(%):-%n}" "${(%):-%M}"
	[[ -n $TMUX ]] && printf '\ek%s %s@%s\e\\' "$dir" "${(%):-%n}" "${(%):-%M}"
}
add-zsh-hook precmd _set_title

