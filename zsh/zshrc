# Shared zsh config. install.sh copies it to /etc/zsh/zshrc, so every
# interactive zsh (rcz, maals, root, ...) loads it before the user's ~/.zshrc.
# Private or user-specific settings (secrets, work aliases) go in ~/.zshrc.
#
# Light mode (root and SSH sessions) skips Powerlevel10k, autosuggestions and
# tmux autostart. Override with ZSH_LIGHT=0 or ZSH_LIGHT=1 in the environment.
#
# tmux autostart is opt-in per user: put ZSH_TMUX_AUTOSTART=1 in ~/.zshenv.
# (Not ~/.zshrc: that runs after p10k's instant prompt has taken over stdin,
# and tmux then fails with "open terminal failed: not a terminal".)

if [[ -z $ZSH_LIGHT ]]; then
	if (( EUID == 0 )) || [[ -n $SSH_TTY ]]; then
		ZSH_LIGHT=1
	else
		ZSH_LIGHT=0
	fi
fi

_zsrc() { [[ -r $1 ]] && source "$1" }

###
### BEFORE INSTANT PROMPT
### p10k's instant prompt points stdin at /dev/null until init finishes, so
### anything that needs the terminal must run above it.
###

[[ -t 1 ]] && tabs 4

# ssh-agent: use the systemd user socket when enabled
# (systemctl --user enable --now ssh-agent.socket), otherwise tmux starts its own.
if [[ -z $SSH_AUTH_SOCK && -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket ]]; then
	export SSH_AUTH_SOCK=${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket
fi

tmux() {
	# Only a brand new tmux server gets wrapped in its own ssh-agent.
	if [[ -z $SSH_AUTH_SOCK && -z $TMUX ]] && ! command tmux has-session 2>/dev/null; then
		command ssh-agent tmux -2 "$@"
	else
		command tmux -2 "$@"
	fi
}

# Start tmux on login if the user opted in and has no tmux running yet
if [[ $ZSH_TMUX_AUTOSTART == 1 ]] && (( ! ZSH_LIGHT )) && [[ -z $TMUX && -t 0 ]] \
		&& (( $+commands[tmux] )) \
		&& ! command tmux has-session 2>/dev/null; then
	cd && tmux
fi

if (( ! ZSH_LIGHT )); then
	typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
	_zsrc "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

