# Start Polybars
exec_always --no-startup-id ~/bin/poly

# Start dunst (notification daemon)
exec --no-startup-id dunst -config ~/.config/i3/dunst.conf

# Screenshots
exec --no-startup-id flameshot
exec --no-startup-id greenclip daemon

# Pipewire patchbay
exec --no-startup-id qpwgraph -a -m

# Ensure suspend triggers lock
exec xss-lock --transfer-sleep-lock -- /home/rcz/bin/lock

# Fix mouse speed
# (centered for main screen right)
#exec xinput set-prop $(xinput | sed -n -e '/ZOWIE/ s/.*id=//p' | awk '{print $1}') 155 0.5, 0, 1440, 0, 0.5, 276, 0, 0, 1
#exec xinput set-prop $(xinput | sed -n -e '/ZOWIE/ s/.*id=//p' | awk '{print $1}') 155 0.5, 0, 0, 0, 0.5, 0, 0, 0, 1 
#exec xinput set-prop 'BenQ ZOWIE BenQ ZOWIE Gaming Mouse' 'libinput Accel Speed' -0.3
exec xinput set-prop 'BenQ ZOWIE BenQ ZOWIE Gaming Mouse' 'libinput Accel Speed' -0.5

# Start compton
# exec compton --config ~/.config/compton.conf -b

# Android notifications
# exec --no-startup-id linconnect-server

# Set modifier key (winkey)
set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below. ISO 10646 = Unicode
font pango:Terminus 8px

#bindsym $mod+t border normal
#bindsym $mod+y border 1pixel
bindsym $mod+u border none

default_border pixel 1
default_floating_border pixel 1
#new_window 1pixel
#new_float  1pixel

# Gaps
smart_gaps on
gaps inner 2
gaps outer 2
smart_borders no_gaps

# Colors
client.focused			#909737	#909737	 #111111
client.focused_inactive #111111 #111111 #999999
client.unfocused        #222222 #222222 #999999
client.urgent           #a5a5a5 #a5a5a5 #2e3436
client.background       #161616

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
#bindsym $mod+Return exec urxvt
bindsym $mod+Return exec kitty

# kill focused window
bindsym $mod+Shift+q kill
bindsym $mod+q kill

# toggle keyboard layout
bindsym $mod+space exec ~/bin/kbtoggle

# start app launcher
bindsym $mod+d exec rofi -show run

bindsym $mod+H focus left
bindsym $mod+J focus down
bindsym $mod+K focus up
bindsym $mod+L focus right

bindsym $mod+Shift+H move left
bindsym $mod+Shift+J move down
bindsym $mod+Shift+K move up
bindsym $mod+Shift+L move right

# split
bindsym $mod+b split h
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+backspace focus mode_toggle

# workspaces
workspace 1 output DisplayPort-0
workspace 2 output DisplayPort-0
workspace 3 output DisplayPort-0
workspace 4 output DisplayPort-0
workspace 5 output DisplayPort-0
workspace 6 output HDMI-A-1
workspace 7 output HDMI-A-1
workspace 8 output HDMI-A-1
workspace 9 output HDMI-A-1

# switch to workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9

# move window to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9

# hotkeys
bindsym $mod+i exec xclip -o | parallel -X mpv {}
bindsym $mod+p exec xclip -o | parallel -X streamlink --player mpv {} best

# Clipboard history (greenclip)
bindsym $mod+Insert exec --no-startup-id rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}'
bindsym $mod+o exec /home/rcz/bin/lock
bindsym Print exec flameshot gui -c
bindsym Shift+Print exec flameshot screen -c
bindsym $mod+Print exec screencap
bindsym $mod+Shift+Print exec screencap -s
bindsym $mod+x scratchpad show
bindsym $mod+Shift+x move scratchpad

bindsym XF86AudioRaiseVolume exec amixer -q set Master 2dB+ unmute
bindsym XF86AudioLowerVolume exec amixer -q set Master 2dB- unmute
bindsym XF86AudioMute exec amixer -q set Master toggle
bindsym XF86Calculator exec speedcrunch

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Do you really want to exit i3?' -b 'Yes, exit i3' 'i3-msg exit'"

bindsym $mod+F9 exec xrandr --output DisplayPort-0 --mode 2560x1440 --rate 180.08 --gamma 1:1:1 --primary --dpi 116 --right-of HDMI-A-1
bindsym $mod+F10 exec xrandr --output DisplayPort-0 --mode 2560x1440 --rate 180.08 --gamma 1.45:1.45:1.45 --primary --dpi 116 --right-of HDMI-A-1
bindsym $mod+F11 exec xrandr --output DisplayPort-0 --mode 2560x1440 --rate 180.08 --gamma 1.75:1.75:1.75 --primary --dpi 116 --right-of HDMI-A-1

# resize window
mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

assign [class="(?i)termite" instance="^term1$"] 6
assign [class="(?i)chromium"] 1
assign [class="(?i)firefox"] 1
assign [class="(?i)firefox developer edition"] 1
assign [class="(?i)google-chrome"] 1
assign [class="(?i)steam"] 4
assign [title="(?i)steam"] 4
assign [class="(?i)discord"] 7
assign [class="(?i)pyfa.py"] 2
assign [title="(?i)EVE Launcher"] 4
assign [class="(?i)EVE"] 4
assign [title="(?i)Rocket League.*"] 5
#assign [class="(?i)cs2"] 5
#assign [class="(?i)steam_app.*"] 5
assign [class="(?i)dota_linux"] 5
assign [class="(?i)dota2"] 5
#assign [class="(?i)dota_csgo"] 5
for_window [title="(?i)EVE - Psychedemic"] move to workspace 3
for_window [title="(?i)EVE - Ricas"] move to workspace 5

# Float stuff
for_window [window_role="pop-up"] floating enable,move absolute center,border normal
for_window [window_role="GtkFileChooserDialog"] floating enable,move absolute center,border normal
for_window [title="Open Files"] floating enable,move absolute center,border normal
for_window [class="(?i)python2\.7"] floating enable
for_window [class="(?i)steam_app_8500"] floating enable
for_window [class="(?i)ioquake3"] floating disable,border none
for_window [class="(?i)explorer.exe"] floating disable,border none
for_window [class="(?i)dota_linux"] floating disable,fullscreen,border none
for_window [class="(?i)dota_csgo"] floating disable,fullscreen,border none
for_window [class="(?i)cs2"] floating disable,fullscreen,border none
for_window [class="(?i)Chromium"] floating disable,border none
for_window [class="(?i)Google-Chrome"] floating disable,border none
for_window [class="(?i)exefile\.exe"] floating disable,border none
for_window [title="QUAKE LIVE Launcher" class="Wine"] floating enable
for_window [title="Quake Live" class="Wine"] floating enable
for_window [class="(?i)Remote Desktop Connection"] floating disable,fullscreen,border none
for_window [class="Telegram"] move scratchpad,resize set 300 500
#for_window [title="(?i)steam_app.*"] floating disable,border none,fullscreen,move container to workspace 5
for_window [title="(?i)mordhau.*"] floating disable,border none,fullscreen,move container to workspace 5
for_window [title="Game Servers"] floating enable,move container to workspace 6
for_window [class="(?i).*Remote Desktop Connection"] floating enable,border none,fullscreen

exec steam
#exec chromium
exec firefox
#exec termite --name="irc" -e weechat
exec --no-startup-id ~/bin/fehbg
